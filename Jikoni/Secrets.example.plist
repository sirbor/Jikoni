<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to `Secrets.plist` (same folder) and fill in your Supabase
  project's URL and anon (public) key — Project Settings > API in the
  Supabase dashboard. `Secrets.plist` is gitignored and read at runtime by
  SupabaseConfig; without it, the app falls back to the Mock* repositories.
-->
<plist version="1.0">
<dict>
    <key>SUPABASE_URL</key>
    <string></string>
    <key>SUPABASE_ANON_KEY</key>
    <string></string>
</dict>
</plist>
